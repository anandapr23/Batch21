{
	"name": "Dynamic_Parquet_File",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_BLOB",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"ContainerName": {
				"type": "string"
			},
			"FolderName": {
				"type": "string"
			},
			"FileName": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": {
					"value": "@dataset().FileName",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().FolderName",
					"type": "Expression"
				},
				"container": {
					"value": "@dataset().ContainerName",
					"type": "Expression"
				}
			},
			"compressionCodec": "snappy"
		},
		"schema": []
	}
}